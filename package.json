{
  "name": "unity-learning-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "generate:worker-manifest": "node scripts/generate-curriculum-manifest.mjs",
    "check:worker": "npm run generate:worker-manifest && node --check worker/src/index.js && node --check worker/src/curriculum.generated.js",
    "test:worker": "node --test worker/test/worker.test.mjs",
    "verify": "npm run typecheck && npm run check:worker && npm run test:worker && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "miniflare": "4.20260730.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "sharp": "0.35.4",
    "undici": "7.29.1",
    "ws": "8.21.3"
  }
}
